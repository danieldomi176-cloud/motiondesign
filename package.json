{
  "name": "football-shorts-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Estúdio de produção de YouTube Shorts de futebol com Remotion e FFmpeg",
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "dev": "npm run studio",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "doctor": "tsx scripts/doctor.ts",
    "render": "tsx scripts/render.ts",
    "validate": "tsx scripts/validate.ts",
    "metadata": "tsx scripts/metadata.ts",
    "speech:setup": "bash scripts/setup-speech.sh",
    "speech": "bash scripts/speech.sh"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/captions": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
